# Safe template only. Put real values in .env.development.local, never here.
# For a new checkout: cp .env.example .env.development.local
# Do not overwrite an existing local file; add missing variables instead.

ENV=dev
APP_NAME=listed
DEBUG=false
SENTRY_DSN=

# Backend database and Supabase credentials
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Movies and TV: TMDB API Read Access Token (not the v3 API key)
TMDB_READ_ACCESS_TOKEN=

# Places and restaurants: Geoapify project API key
GEOAPIFY_API_KEY=

# Video games: Twitch application's Client ID and Client Secret for IGDB
# The backend will obtain short-lived access tokens; do not save those here.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Events: Ticketmaster Discovery API Consumer Key
TICKETMASTER_API_KEY=

# Apple iTunes podcast search and Open Library book search need no API keys.
